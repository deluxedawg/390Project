<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="24dp">

    <TextView
        style="@style/TextAppearance.ReflexTrainer.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HISTORY"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How your reaction time is trending"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvNoHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No sessions yet. Start training to see your results here."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingTop="48dp"
        android:paddingHorizontal="12dp"
        android:visibility="gone"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleModesRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeReaction"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Reaction"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeRhythm"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Rhythm"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleModesRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeFatigue"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Fatigue"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeSimon"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Simon"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE RANGE"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDateFrom"
                    style="@style/AppButton.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:textSize="13sp"
                    android:text="From: Any"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDateTo"
                    style="@style/AppButton.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:textSize="13sp"
                    android:text="To: Any"/>

            </LinearLayout>

            <TextView
                style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE RANGE"/>

            <TextView
                android:id="@+id/tvScoreRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/sliderScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trackColorActive="@color/accent"
                app:trackColorInactive="@color/line"
                app:thumbColor="@color/accent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearFilters"
                style="@style/AppButton.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Clear filters"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:tabBackground="@color/surface"
        app:tabIndicatorColor="@color/accent"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/text_secondary"
        app:tabRippleColor="@null">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numerical"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Graph"/>
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackHome"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:layout_marginTop="12dp"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="24dp">

    <TextView
        style="@style/TextAppearance.ReflexTrainer.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROFILE"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your account and preferences"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- view mode -->
            <LinearLayout
                android:id="@+id/groupProfileView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_avatar_1"
                    android:contentDescription="@string/your_avatar"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/accent"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_edit_pencil"
                    android:tint="@color/text_secondary"
                    android:scaleType="center"
                    android:contentDescription="@string/edit_profile"/>
            </LinearLayout>

            <!-- edit mode -->
            <LinearLayout
                android:id="@+id/groupProfileEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="22dp">

                <TextView
                    style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE AN AVATAR"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard0"
                        style="@style/AvatarPickerCard">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_1"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard1"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_2"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard2"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_3"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard3"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_4"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard4"
                        style="@style/AvatarPickerCard">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_5"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard5"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_6"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard6"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_7"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard7"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_8"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard8"
                        style="@style/AvatarPickerCard">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_9"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard9"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_10"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard10"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_11"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard11"
                        style="@style/AvatarPickerCard"
                        android:layout_marginStart="10dp">
                        <ImageView style="@style/AvatarPickerImage" android:src="@drawable/ic_avatar_12"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERNAME"
                    android:layout_marginTop="22dp"/>

                <EditText
                    android:id="@+id/etUsernameEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="18sp"
                    android:backgroundTint="@color/accent"
                    android:maxLines="1"
                    android:inputType="textPersonName"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelEdit"
                        style="@style/AppButton.Outline"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Cancel"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        style="@style/AppButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:text="Save"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI COACH"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show personalized training tips after each session."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAiCoach"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddFriend"
        style="@style/AppButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Friend"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFriends"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Friends &amp; Requests"
        android:layout_marginBottom="12dp"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackHome"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"/>

</LinearLayout>

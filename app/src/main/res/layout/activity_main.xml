<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:paddingBottom="190dp">

            <ImageView
                android:id="@+id/ivHomeAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_avatar_1"
                android:contentDescription="@string/your_avatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/tvWelcome"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="14dp"/>

            <TextView
                android:id="@+id/tvGreetingLabel"
                style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="WELCOME BACK"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivHomeAvatar"
                app:layout_constraintEnd_toStartOf="@id/btnLogout"
                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/tvGreetingLabel"
                app:layout_constraintStart_toEndOf="@id/ivHomeAvatar"
                app:layout_constraintEnd_toStartOf="@id/btnLogout"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"/>

            <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_logout"
                android:tint="@color/text_secondary"
                android:scaleType="center"
                android:contentDescription="@string/log_out"
                app:layout_constraintTop_toTopOf="@id/tvGreetingLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvWelcome"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Sensor status card: literal light-gate readout (hold / set / go) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvWelcome"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SENSOR"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/gateLights"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/dotHold"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/dot_light"
                                app:tint="@color/danger"/>

                            <ImageView
                                android:id="@+id/dotSet"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/dot_light"
                                app:tint="@color/color_set"/>

                            <ImageView
                                android:id="@+id/dotGo"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/dot_light"
                                app:tint="@color/accent"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSensorStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disconnected"
                            android:textColor="@color/danger"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="14dp"/>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Streak: consecutive days trained -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardStatus"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_streak"
                        app:tint="@color/color_set"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvStreakSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading..."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Achievements: badge shelf, colored = earned, dimmed = locked -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardStreak"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.ReflexTrainer.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACHIEVEMENTS"/>

                    <TextView
                        android:id="@+id/tvBadgeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:id="@+id/badgeRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView android:id="@+id/badge0" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_1"/>
                            <ImageView android:id="@+id/badge1" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_5" android:layout_marginStart="12dp"/>
                            <ImageView android:id="@+id/badge2" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_8" android:layout_marginStart="12dp"/>
                            <ImageView android:id="@+id/badge3" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_4" android:layout_marginStart="12dp"/>
                            <ImageView android:id="@+id/badge4" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_6" android:layout_marginStart="12dp"/>
                            <ImageView android:id="@+id/badge5" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_3" android:layout_marginStart="12dp"/>
                            <ImageView android:id="@+id/badge6" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_2" android:layout_marginStart="12dp"/>
                            <ImageView android:id="@+id/badge7" style="@style/BadgeIcon" android:src="@drawable/ic_avatar_7" android:layout_marginStart="12dp"/>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Primary action: fixed above the dock so it's always in thumb reach -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        style="@style/AppButton"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:text="Start Training"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dockBar"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"/>

    <!-- Floating dock: the 4 secondary destinations, icon-only -->
    <androidx.cardview.widget.CardView
        android:id="@+id/dockBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="30dp"
        app:cardElevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="22dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnViewHistory"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_history"
                android:tint="@color/text_secondary"
                android:scaleType="center"
                android:contentDescription="@string/nav_history"/>

            <ImageButton
                android:id="@+id/btnLeaderboard"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_leaderboard"
                android:tint="@color/text_secondary"
                android:scaleType="center"
                android:contentDescription="@string/nav_leaderboard"/>

            <ImageButton
                android:id="@+id/btnChallenges"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_challenges"
                android:tint="@color/text_secondary"
                android:scaleType="center"
                android:contentDescription="@string/nav_challenges"/>

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_profile"
                android:tint="@color/text_secondary"
                android:scaleType="center"
                android:contentDescription="@string/nav_profile"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvPhase"
            style="@style/TextAppearance.ReflexTrainer.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RHYTHM"/>

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listen to the beat first"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"/>

        <!-- the shrinking-ring view sits here -->
        <com.team5.reflextrainer.RingView
            android:id="@+id/ringView"
            android:layout_width="240dp"
            android:layout_height="240dp"/>

        <TextView
            android:id="@+id/tvFeedback"
            style="@style/TextAppearance.ReflexTrainer.Readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:background="@drawable/bg_readout"
            android:minWidth="160dp"
            android:gravity="center"
            android:layout_marginTop="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Start Listening"
            android:layout_marginTop="40dp"/>

    </LinearLayout>
</FrameLayout>
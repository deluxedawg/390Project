<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- scoreboard-style display face, used sparingly for wordmark + screen headlines -->
    <style name="TextAppearance.ReflexTrainer.Display" parent="">
        <item name="android:fontFamily">@font/anton</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- tabular-figure readout face for ms times, ranks, scores -->
    <style name="TextAppearance.ReflexTrainer.Readout" parent="">
        <item name="android:fontFamily">@font/space_mono_bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- small uppercase section label used above headlines -->
    <style name="TextAppearance.ReflexTrainer.Eyebrow" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="AppButton.Danger">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- unobtrusive text-only action, e.g. Log out -->
    <style name="AppButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- one option in the avatar picker grid; stroke toggled at runtime to mark selection -->
    <style name="AvatarPickerCard" parent="">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/accent</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="rippleColor">@color/line</item>
    </style>

    <style name="AvatarPickerImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:padding">3dp</item>
    </style>

    <!-- badge shelf entry; alpha toggled at runtime for earned vs locked -->
    <style name="BadgeIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

</resources>